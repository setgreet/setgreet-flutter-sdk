# iOS 15.1, the floor the post_install below raises every pod to. Keep it in
# step with the Runner target (IPHONEOS_DEPLOYMENT_TARGET in
# Runner.xcodeproj) and Flutter/AppFrameworkInfo.plist (MinimumOSVersion):
# Xcode 27 supports nothing below iOS 15.0.
#
# The Runner target also excludes x86_64 from simulator builds
# (EXCLUDED_ARCHS[sdk=iphonesimulator*]): with two simulator architectures,
# Flutter 3.38's build script runs `lipo -verify_arch arm64 x86_64`, which
# Xcode 27's lipo rejects.
platform :ios, '15.1'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# The opt-in Lottie module (SetgreetSDKLottie) is a prebuilt framework that
# loads lottie-ios as a dynamic framework, so pods are built as dynamic
# frameworks (Flutter's default).
use_frameworks! :linkage => :dynamic

target 'Runner' do
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # SetgreetSDK comes from the plugin's podspec, which pins the version, so
  # the example cannot drift from the plugin. The Lottie subspec is the
  # opt-in for Lottie animations (see `Setgreet.registerLottie()` in main.dart).
  pod 'setgreet/Lottie', :path => '.symlinks/plugins/setgreet/ios'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Ensure all pods use at least iOS 15.1
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current && Gem::Version.new(current) < Gem::Version.new('15.1')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end

    # Lottie support (opt-in): SetgreetSDKLottie was compiled against a Lottie
    # built with library evolution, so lottie-ios must be built that way too
    if target.name == 'lottie-ios'
      target.build_configurations.each do |config|
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end
  end
end
